# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key

# Admin panel access (shared secret — set your own long random string)
ADMIN_KEY=change-me-to-a-long-random-string

# Server
PORT=4000
RENDER_EXTERNAL_URL=

# Email (Resend)
RESEND_API_KEY=
FROM_EMAIL=QuickShop <onboarding@resend.dev>

# SMS (Africa's Talking) — optional
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=

# Push (OneSignal) — optional
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=

# Telegram — optional
TELEGRAM_BOT_TOKEN=

# Payments (Paystack) — optional, for pay_online orders
PAYSTACK_SECRET_KEY=
